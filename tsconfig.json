{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "global-setup.ts",
    "global-teardown.ts",
    "config/**/*.ts",
    "fixtures/**/*.ts",
    "reporters/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts"
  ]
}
